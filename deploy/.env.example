# --- DATABASE CONFIGURATION ---
DB_PORT=5432
POSTGRES_DB=teamroom_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password_here

# --- AUTHENTICATION ---
JWT_SECRET=your_super_secret_jwt_token
# 7 days in milliseconds
JWT_EXPIRATION=604800000

# --- CLOUD STORAGE (pCloud) ---
PCLOUD_TOKEN=your_pcloud_token
PCLOUD_USERNAME=your_pcloud_email
PCLOUD_PASS=your_pcloud_password

# --- JITSI INTEGRATION ---
JITSI_APP_ID=team-room-app
JITSI_APP_SECRET=your_jitsi_app_secret
JITSI_DOMAIN=your.domain.com
JITSI_TOKEN_LIFETIME=86400

# --- JITSI WEBHOOKS ---
# This matches the endpoint created in Spring Boot
BACKEND_WEBHOOK_URL=http://backend:8080/api/jitsi/event